# ═══════════════════════════════════════════════════════════════════════════════
#  ZEGA WEB FRONTEND (.env.example)
#  Only VITE_ prefixed public variables are exposed to the browser bundle.
# ═══════════════════════════════════════════════════════════════════════════════

# Backend API base URL (Render production or localhost dev)
VITE_API_URL=http://localhost:3001

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare CDN & Turnstile
VITE_CDN_URL=https://cdn.zegaai.site
VITE_CLOUDFLARE_TURNSTILE_SITEKEY=0x4AAAAAA...
