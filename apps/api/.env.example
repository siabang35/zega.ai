# ═══════════════════════════════════════════════════════════════════════════════
#  ZEGA BACKEND API (.env.example)
#  Contains server-only secrets. NEVER EXPOSE TO FRONTEND OR BUNDLE.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server Core ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://app.zega.ai

# ─── Supabase Server Secrets ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ─── Cloudflare R2 Object Storage Credentials ────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=zega-assets-prod
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://cdn.zega.ai

# ─── Cloudflare Turnstile Secret ─────────────────────────────────────────────
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAA...

# ─── OWASP Security Hardening Cryptographic Secrets ──────────────────────────
COOKIE_SECRET=your-secure-cookie-signing-secret-minimum-64-bytes-long
JWT_SECRET=your-production-jwt-signing-key-minimum-64-bytes-long
ENCRYPTION_KEY=32-byte-hex-key-for-aes-256-gcm-agent-key-encryption

# ─── Rate Limiting Controls ─────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
