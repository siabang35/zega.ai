# ═══════════════════════════════════════════════════════════════════════════════
#  ZEGA BACKEND API (.env.example)
#  Contains server-only secrets. NEVER EXPOSE TO FRONTEND OR BUNDLE.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server Core ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173,https://zegaai.site,https://*.vercel.app

# ─── Supabase Server Secrets ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Brevo Email OTP (SMTP Relay) ────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_KEY=your-brevo-smtp-key
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=no-reply@zegaai.site

# ─── Cloudflare Turnstile Secret ─────────────────────────────────────────────
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAA...

# ─── Cloudflare R2 Object Storage Credentials ────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=zega-ai
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://cdn.zegaai.site

# ─── OWASP Security Hardening Cryptographic Secrets ──────────────────────────
COOKIE_SECRET=your-secure-cookie-signing-secret-minimum-64-bytes-long
JWT_SECRET=your-production-jwt-signing-key-minimum-64-bytes-long

# ─── Rate Limiting Controls ─────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ─── MULTI-LLM PROVIDER API KEYS (ZeroClaw Agent Runtime Engine) ────────────────
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
HUGGINGFACE_API_KEY=your-huggingface-token-here
JATEVO_API_KEY=your-jatevo-api-key-here
NINE_ROUTER_API_KEY=your-9router-token-here
