# ═══════════════════════════════════════════════════════════════════════════════
#  ZEGA AI — ENTERPRISE ENVIRONMENT CONFIGURATION (.env.example)
#  Adheres to OWASP Security Guidelines & Microservices Separation
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. SUPABASE (Database, Auth, Row-Level Security, Realtime) ─────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... # SERVER-ONLY ADMIN KEY
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ─── 2. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible CDN) ─────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key # SERVER-ONLY SECRET
R2_BUCKET_NAME=zega-assets-prod
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://cdn.zega.ai # CLOUDFLARE CUSTOM CDN DOMAIN

# ─── 3. CLOUDFLARE SERVICES & TURNSTILE (Bot & Anti-DDoS) ───────────────────
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAA... # SERVER-ONLY SECRET
VITE_CLOUDFLARE_TURNSTILE_SITEKEY=0x4AAAAAA... # PUBLIC FRONTEND SITEKEY

# ─── 4. API SERVER & OWASP SECURITY HARDENING (apps/api) ────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://app.zega.ai # STRICT ORIGIN WHITELIST
COOKIE_SECRET=your-secure-cookie-signing-secret-64-bytes
JWT_SECRET=your-production-jwt-signing-key-minimum-64-bytes
ENCRYPTION_KEY=32-byte-hex-key-for-aes-256-gcm-agent-key-encryption

# ─── 5. RATE LIMITING & SECURITY CAPS ─────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000 # 1 MINUTE WINDOW

# ─── 6. FRONTEND PUBLIC VARS (apps/web - VITE_ PREFIX ONLY) ───────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_URL=http://localhost:3001
VITE_CDN_URL=https://cdn.zega.ai
